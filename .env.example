# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=aic_user
POSTGRES_PASSWORD=aic_password
POSTGRES_DB=aic_db

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO ────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_RAW_BUCKET=raw-images
MINIO_ANNOTATED_BUCKET=annotated-images

# ── App ──────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── Anthropic (plan analysis via Claude vision) ───────────
ANTHROPIC_API_KEY=

# ── Twilio WhatsApp (scheduled report sending — demo scope) ─
# Get these from a free Twilio account's Console > Messaging > Try it
# out > Send a WhatsApp message (the Sandbox). TWILIO_WHATSAPP_FROM is
# the sandbox number Twilio gives you, no "whatsapp:" prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public HTTPS URL for this backend so Twilio can fetch the report PDF —
# an ngrok tunnel is the fastest way to get one for a demo:
#   ngrok http 8000
# then paste the https://*.ngrok-free.app URL it prints here.
BACKEND_PUBLIC_URL=

# ── Edge Agent ───────────────────────────────────────────
BACKEND_URL=http://localhost:8000
DEVICE_ID=edge-device-001
PROJECT_ID=           # fill in after creating project via API
CAPTURE_INTERVAL=300  # seconds between captures
